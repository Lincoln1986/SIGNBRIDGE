              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"contiene el ticket creado\", () => pm.expect(pm.response.json().map(t => t.id_support)).to.include(pm.environment.get(\"ticket\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar mi ticket",
