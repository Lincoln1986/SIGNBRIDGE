# ── Base de datos ──────────────────────────────────────────
# PostgreSQL (entorno normal):
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/sign_bridge
# Modo local sin Docker (SQLite, el archivo lo crea `uv run alembic upgrade head`):
# DATABASE_URL=sqlite:///./signbridge-local.db

# ── JWT ────────────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_secreta_muy_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Mailtrap SMTP ──────────────────────────────────────────
MAIL_USERNAME=tu_usuario_mailtrap
MAIL_PASSWORD=tu_password_mailtrap
MAIL_FROM=noreply@signbridge.com
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=587

# ── App ────────────────────────────────────────────────────
APP_NAME=Sign_Bridge
FRONTEND_URL=http://localhost:3000
