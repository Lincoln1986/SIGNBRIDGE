# ── Copiá este archivo a .env y ajustá los valores ─────────────────────────
#    cp .env.example .env
#
# Lo lee docker compose. NO subas el .env al repositorio.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=signbridge
POSTGRES_PORT=5432

# ── JWT ────────────────────────────────────────────────────────────────────
# Generá una propia con:  openssl rand -hex 32
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Límite de intentos de inicio de sesión (fallos permitidos y minutos de bloqueo)
LOGIN_MAX_INTENTOS_CORREO=5
LOGIN_MAX_INTENTOS_IP=20
LOGIN_BLOQUEO_MINUTOS=15

# Cookie de sesión. COOKIE_SECURE=true solo cuando la app esté detrás de HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── SMTP (Mailtrap sandbox o servidor real) ────────────────────────────────
# Sin credenciales la aplicación funciona igual; solo no se envían los correos
# de bienvenida, recuperación de contraseña y ticket resuelto.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@signbridge.com
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525

# ── Puertos y URLs ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
APP_NAME=Sign_Bridge

# Swagger en /docs. false en cualquier servidor que se vea desde afuera:
# le muestra a un atacante todas las rutas de la API. true solo para probar en local.
DOCS_HABILITADOS=false
